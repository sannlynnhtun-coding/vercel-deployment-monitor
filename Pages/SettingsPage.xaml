<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VercelDeploymentMonitor.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" Spacing="16" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Connect this WinUI app to Vercel with a personal API token and optional team/project filters." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Desktop delivery note"
                    Message="Vercel webhooks require a public HTTPS endpoint. This WinUI app uses REST polling so it can run locally without exposing your PC. Add a relay later if you need true push." />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Vercel API" FontSize="18" FontWeight="SemiBold" />

                        <PasswordBox x:Name="TokenBox" Header="Vercel API token" PlaceholderText="Paste token from Vercel Account Settings > Tokens" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TeamIdBox" Header="Team ID (optional)" PlaceholderText="team_..." />
                            <TextBox x:Name="TeamSlugBox" Grid.Column="1" Header="Team slug (optional)" PlaceholderText="your-team-slug" />
                        </Grid>

                        <TextBox x:Name="ProjectFilterBox" Header="Project filter (optional)" PlaceholderText="Use project id prj_... or project name/app slug. Leave empty to watch all visible projects." />

                        <NumberBox x:Name="PollIntervalBox" Header="Poll interval in seconds" Minimum="10" Maximum="600" SmallChange="5" LargeChange="30" SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="The token is stored in Windows Credential Locker. Non-secret settings stay under your Windows user profile." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="SettingsPathBox" Header="Settings file" IsReadOnly="True" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Save settings" Click="SaveSettings_Click" />
                            <Button Content="Test connection" Click="TestConnection_Click" />
                            <Button Content="Load projects" Click="LoadProjects_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="SettingsInfoBar"
                    IsOpen="False"
                    IsClosable="False" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Projects" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Load projects after entering a token. Select a row to copy its project id into the filter above." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ListView x:Name="ProjectsList" Grid.Row="1" ItemsSource="{x:Bind Projects}" SelectionChanged="ProjectsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,8" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding UpdatedLabel}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

