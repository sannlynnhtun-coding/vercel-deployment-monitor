<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VercelDeploymentMonitor.Pages.DeploymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VercelDeploymentMonitor.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Vercel deployment monitor" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="List deployments, inspect build logs, and get local Windows notifications when a deployment succeeds or fails." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="32" Height="32" IsActive="False" />
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Ready"
            Message="Add your Vercel API token in Settings, then refresh or start monitoring." />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Content="Start monitor" Click="StartMonitoring_Click" />
            <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopMonitoring_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh now" Click="Refresh_Click" />
            <TextBlock x:Name="LastRefreshText" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Grid.Column="4" Content="Vercel dashboard" NavigateUri="https://vercel.com/dashboard" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Deployment list" FontSize="18" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Total" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TotalCountText" Text="0" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Building" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="BuildingCountText" Text="0" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ReadyCountText" Text="0" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Failed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="FailedCountText" Text="0" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListView
                        x:Name="DeploymentsList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind Deployments}"
                        SelectionChanged="DeploymentsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CreatedLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border
                                            MinWidth="92"
                                            Background="{Binding StatusBadgeBackground}"
                                            BorderBrush="{Binding StatusBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3">
                                            <TextBlock
                                                Text="{Binding StatusLabel}"
                                                Foreground="{Binding StatusBadgeForeground}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Text="{Binding ShortIdLabel}"
                                            FontFamily="Cascadia Mono"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Build and deploy logs" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedDeploymentText" Text="Select a deployment to load build + deployment events." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="OpenDeploymentButton" Grid.Column="1" Content="Open deploy URL" Click="OpenDeployment_Click" IsEnabled="False" />
                        <Button x:Name="OpenProductionButton" Grid.Column="2" Content="Open production URL" Click="OpenProduction_Click" IsEnabled="False" />
                        <Button x:Name="OpenDashboardButton" Grid.Column="3" Content="Open in Vercel" Click="OpenDashboard_Click" IsEnabled="False" />
                        <Button x:Name="CopyLogsButton" Grid.Column="4" Content="Copy logs" Click="CopyLogs_Click" IsEnabled="False" />
                    </Grid>

                    <InfoBar
                        x:Name="LogsInfoBar"
                        Grid.Row="1"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Informational" />

                    <TextBox
                        x:Name="LogsTextBox"
                        Grid.Row="2"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        IsReadOnly="True"
                        PlaceholderText="Deployment events appear here."
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
