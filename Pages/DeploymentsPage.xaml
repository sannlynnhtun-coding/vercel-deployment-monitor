<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VercelDeploymentMonitor.Pages.DeploymentsPage" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="using:VercelDeploymentMonitor.Models">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="LogsColumn.Width" Value="0" />
                        <Setter Target="PageScroll.VerticalScrollMode" Value="Enabled" />
                        <Setter Target="PageScroll.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="Workspace.Height" Value="840" />
                        <Setter Target="LogsRow.Height" Value="*" />
                        <Setter Target="LogsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="LogsPanel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="LogsColumn.Width" Value="*" />
                        <Setter Target="PageScroll.VerticalScrollMode" Value="Disabled" />
                        <Setter Target="PageScroll.VerticalScrollBarVisibility" Value="Disabled" />
                        <Setter Target="Workspace.Height" Value="Auto" />
                        <Setter Target="LogsRow.Height" Value="0" />
                        <Setter Target="LogsPanel.(Grid.Row)" Value="0" />
                        <Setter Target="LogsPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid Padding="24,20,24,20" RowSpacing="14" x:Name="PageLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" x:Uid="DeployTextBlock33" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" x:Uid="DeployTextBlock34" />
                </StackPanel>
                <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="32" Height="32" IsActive="False" />
            </Grid>
            <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" x:Uid="DeployStatusInfoBar" />
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="DeployTextBlock45" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="BuildingCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="DeployTextBlock49" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="ReadyCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="DeployTextBlock53" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="FailedCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="DeployTextBlock57" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="StartMonitoring_Click" AccessKey="S" x:Uid="DeployStartButton" AutomationProperties.AutomationId="DeployStartButton" />
                <Button x:Name="StopButton" Grid.Column="1" Click="StopMonitoring_Click" IsEnabled="False" AccessKey="T" x:Uid="DeployStopButton" AutomationProperties.AutomationId="DeployStopButton" />
                <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" AccessKey="R" x:Uid="DeployRefreshButton" AutomationProperties.AutomationId="DeployRefreshButton" />
                <TextBlock x:Name="LastRefreshText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1" Grid.ColumnSpan="4" TextWrapping="Wrap" Visibility="Collapsed" />
                <HyperlinkButton Grid.Column="3" NavigateUri="https://vercel.com/dashboard" HorizontalAlignment="Right" x:Uid="DeployHyperlinkButton72" AutomationProperties.AutomationId="DeployHyperlinkButton72" />
            </Grid>
            <Grid Grid.Row="4" ColumnSpacing="16" x:Name="Workspace" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" x:Name="LogsRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="ListColumn" />
                    <ColumnDefinition Width="*" x:Name="LogsColumn" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="DeployTextBlock85" />
                        <ListView x:Name="DeploymentsList" Grid.Row="1" ItemsSource="{x:Bind Deployments}" SelectionChanged="DeploymentsList_SelectionChanged" x:Uid="DeployDeploymentsList" AutomationProperties.AutomationId="DeployDeploymentsList" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VercelDeployment">
                                    <Grid Padding="0,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind CreatedLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border MinWidth="92" Background="{x:Bind StatusBadgeBackground}" BorderBrush="{x:Bind StatusBadgeBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                                <TextBlock Text="{x:Bind StatusLabel}" Foreground="{x:Bind StatusBadgeForeground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind ShortIdLabel}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16" x:Name="LogsPanel">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" x:Uid="DeployTextBlock110" />
                                <TextBlock x:Name="SelectedDeploymentText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" x:Uid="DeploySelectedDeploymentText" MaxLines="2" />
                            </StackPanel>
                        </Grid>
                        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <AppBarButton x:Name="OpenDeploymentButton" Click="OpenDeployment_Click" IsEnabled="False" Icon="World" x:Uid="DeployOpenDeploymentButton" AutomationProperties.AutomationId="DeployOpenDeploymentButton" />
                            <AppBarButton x:Name="OpenProductionButton" Click="OpenProduction_Click" IsEnabled="False" Icon="Globe" x:Uid="DeployOpenProductionButton" AutomationProperties.AutomationId="DeployOpenProductionButton" />
                            <AppBarButton x:Name="OpenDashboardButton" Click="OpenDashboard_Click" IsEnabled="False" Icon="OpenFile" x:Uid="DeployOpenDashboardButton" AutomationProperties.AutomationId="DeployOpenDashboardButton" />
                            <AppBarButton x:Name="CopyLogsButton" Click="CopyLogs_Click" IsEnabled="False" Icon="Copy" x:Uid="DeployCopyLogsButton" AutomationProperties.AutomationId="DeployCopyLogsButton" />
                        </CommandBar>
                        <InfoBar x:Name="LogsInfoBar" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Informational" />
                        <TextBox x:Name="LogsTextBox" Grid.Row="3" AcceptsReturn="True" FontFamily="Cascadia Mono" FontSize="13" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="16" BorderThickness="0" Background="{ThemeResource LayerFillColorDefaultBrush}" x:Uid="DeployLogsTextBox" AutomationProperties.AutomationId="DeployLogsTextBox" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>